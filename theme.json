{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "name": "Neutral 050", "slug": "neutral-050", "color": "#F7F9FC" },
        { "name": "Neutral 100", "slug": "neutral-100", "color": "#D8E2F1" },
        { "name": "Neutral 200", "slug": "neutral-200", "color": "#B0C2DC" },
        { "name": "Neutral 300", "slug": "neutral-300", "color": "#94A8C7" },
        { "name": "Neutral 400", "slug": "neutral-400", "color": "#798FB0" },
        { "name": "Neutral 500", "slug": "neutral-500", "color": "#62779C" },
        { "name": "Neutral 600", "slug": "neutral-600", "color": "#53688B" },
        { "name": "Neutral 700", "slug": "neutral-700", "color": "#425471" },
        { "name": "Neutral 800", "slug": "neutral-800", "color": "#32435C" },
        { "name": "Neutral 900", "slug": "neutral-900", "color": "#26344B" },

        { "name": "Primary 050", "slug": "primary-050", "color": "#FEF7FB" },
        { "name": "Primary 100", "slug": "primary-100", "color": "#F8D8EB" },
        { "name": "Primary 200", "slug": "primary-200", "color": "#EFADD5" },
        { "name": "Primary 300", "slug": "primary-300", "color": "#E888C1" },
        { "name": "Primary 400", "slug": "primary-400", "color": "#E05DAB" },
        { "name": "Primary 500", "slug": "primary-500", "color": "#D13693" },
        { "name": "Primary 600", "slug": "primary-600", "color": "#BE217F" },
        { "name": "Primary 700", "slug": "primary-700", "color": "#A40162" },
        { "name": "Primary 800", "slug": "primary-800", "color": "#83024F" },
        { "name": "Primary 900", "slug": "primary-900", "color": "#680440" },

        { "name": "Secondary 050", "slug": "secondary-050", "color": "#FBF7FE" },
        { "name": "Secondary 100", "slug": "secondary-100", "color": "#ECDAFB" },
        { "name": "Secondary 200", "slug": "secondary-200", "color": "#D7B2F6" },
        { "name": "Secondary 300", "slug": "secondary-300", "color": "#C096E1" },
        { "name": "Secondary 400", "slug": "secondary-400", "color": "#A67CC8" },
        { "name": "Secondary 500", "slug": "secondary-500", "color": "#8F64B2" },
        { "name": "Secondary 600", "slug": "secondary-600", "color": "#8054A4" },
        { "name": "Secondary 700", "slug": "secondary-700", "color": "#6A418C" },
        { "name": "Secondary 800", "slug": "secondary-800", "color": "#573077" },
        { "name": "Secondary 900", "slug": "secondary-900", "color": "#472265" },

        { "name": "Tertiary 050", "slug": "tertiary-050", "color": "#EEFCFB" },
        { "name": "Tertiary 100", "slug": "tertiary-100", "color": "#A9EDEA" },
        { "name": "Tertiary 200", "slug": "tertiary-200", "color": "#72D0CD" },
        { "name": "Tertiary 300", "slug": "tertiary-300", "color": "#46B7B2" },
        { "name": "Tertiary 400", "slug": "tertiary-400", "color": "#1E9C98" },
        { "name": "Tertiary 500", "slug": "tertiary-500", "color": "#168480" },
        { "name": "Tertiary 600", "slug": "tertiary-600", "color": "#107370" },
        { "name": "Tertiary 700", "slug": "tertiary-700", "color": "#0B5D5B" },
        { "name": "Tertiary 800", "slug": "tertiary-800", "color": "#094B48" },
        { "name": "Tertiary 900", "slug": "tertiary-900", "color": "#073A39" },

        { "name": "Information 050", "slug": "information-050", "color": "#F5F9FC" },
        { "name": "Information 100", "slug": "information-100", "color": "#CFE4F2" },
        { "name": "Information 200", "slug": "information-200", "color": "#9AC6E5" },
        { "name": "Information 300", "slug": "information-300", "color": "#73ADD8" },
        { "name": "Information 400", "slug": "information-400", "color": "#5793BE" },
        { "name": "Information 500", "slug": "information-500", "color": "#3F7CA7" },
        { "name": "Information 600", "slug": "information-600", "color": "#306C98" },
        { "name": "Information 700", "slug": "information-700", "color": "#20577F" },
        { "name": "Information 800", "slug": "information-800", "color": "#1A4665" },
        { "name": "Information 900", "slug": "information-900", "color": "#14364F" },

        { "name": "Negative 050", "slug": "negative-050", "color": "#FDF7F7" },
        { "name": "Negative 100", "slug": "negative-100", "color": "#F7DADA" },
        { "name": "Negative 200", "slug": "negative-200", "color": "#EEB1B1" },
        { "name": "Negative 300", "slug": "negative-300", "color": "#E68F8F" },
        { "name": "Negative 400", "slug": "negative-400", "color": "#DC6A6A" },
        { "name": "Negative 500", "slug": "negative-500", "color": "#C74F4F" },
        { "name": "Negative 600", "slug": "negative-600", "color": "#B83B3B" },
        { "name": "Negative 700", "slug": "negative-700", "color": "#A11F1F" },
        { "name": "Negative 800", "slug": "negative-800", "color": "#841616" },
        { "name": "Negative 900", "slug": "negative-900", "color": "#6A0D0D" },

        { "name": "Positive 050", "slug": "positive-050", "color": "#F1FCF3" },
        { "name": "Positive 100", "slug": "positive-100", "color": "#B6EFC2" },
        { "name": "Positive 200", "slug": "positive-200", "color": "#63D77F" },
        { "name": "Positive 300", "slug": "positive-300", "color": "#42BD6A" },
        { "name": "Positive 400", "slug": "positive-400", "color": "#20A253" },
        { "name": "Positive 500", "slug": "positive-500", "color": "#178849" },
        { "name": "Positive 600", "slug": "positive-600", "color": "#117742" },
        { "name": "Positive 700", "slug": "positive-700", "color": "#0B6037" },
        { "name": "Positive 800", "slug": "positive-800", "color": "#094D2C" },
        { "name": "Positive 900", "slug": "positive-900", "color": "#073D23" },

        { "name": "White", "slug": "white", "color": "#ffffff" },
        { "name": "Black", "slug": "black", "color": "#0D0D0D" }
      ],
      "gradients": [
        {
          "name": "Primary gradient",
          "slug": "primary",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary-400), var(--wp--preset--color--secondary-600))"
        },
        {
          "name": "Tertiary gradient",
          "slug": "tertiary",
          "gradient": "linear-gradient(135deg, var(--wp--preset--color--tertiary-300), var(--wp--preset--color--tertiary-600))"
        },
        {
          "name": "Hero gradient",
          "slug": "hero",
          "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary-050) 0%, var(--wp--preset--color--secondary-050) 50%, var(--wp--preset--color--neutral-050) 100%)"
        }
      ],
      "duotone": [
        {
          "name": "Primary duotone",
          "slug": "primary",
          "colors": [ "#D7B2F6", "#A40162" ]
        }
      ]
    },

    "typography": {
      "defaultFontSizes": false,
      "lineHeight": true,
      "letterSpacing": true,
      "textTransform": true,
      "textDecoration": true,
      "fontFamilies": [
        {
          "name": "Inclusive Sans",
          "slug": "inclusive-sans",
          "fontFamily": "'Inclusive Sans', 'Trebuchet MS', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inclusive Sans",
              "fontWeight": "400",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/InclusiveSans-Variable.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "name": "2XS",    "slug": "2xs",    "size": "clamp(0.625rem, 0.6rem + 0.125vw, 0.75rem)",  "fluid": false },
        { "name": "XS",     "slug": "xs",     "size": "clamp(0.75rem,  0.7rem + 0.25vw,  0.875rem)", "fluid": false },
        { "name": "Small",  "slug": "small",  "size": "clamp(0.875rem, 0.82rem + 0.28vw, 1rem)",     "fluid": false },
        { "name": "Base",   "slug": "base",   "size": "clamp(1rem,     0.95rem + 0.25vw, 1.125rem)", "fluid": false },
        { "name": "Medium", "slug": "medium", "size": "clamp(1.125rem, 1rem + 0.625vw,  1.5rem)",    "fluid": false },
        { "name": "Large",  "slug": "large",  "size": "clamp(1.375rem, 1.1rem + 1.375vw, 2rem)",     "fluid": false },
        { "name": "XL",     "slug": "xl",     "size": "clamp(1.75rem,  1.3rem + 2.25vw,  2.75rem)",  "fluid": false },
        { "name": "2XL",    "slug": "2xl",    "size": "clamp(2.25rem,  1.5rem + 3.75vw,  4rem)",     "fluid": false },
        { "name": "3XL",    "slug": "3xl",    "size": "clamp(2.75rem,  1.75rem + 5vw,    5.5rem)",   "fluid": false }
      ]
    },

    "spacing": {
      "defaultSpacingSizes": false,
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": [ "px", "em", "rem", "vh", "vw", "%", "svh", "svw" ],
      "spacingSizes": [
        { "name": "1 — 4px",    "slug": "1",  "size": "0.25rem" },
        { "name": "2 — 8px",    "slug": "2",  "size": "0.5rem"  },
        { "name": "3 — 12px",   "slug": "3",  "size": "0.75rem" },
        { "name": "4 — 16px",   "slug": "4",  "size": "1rem"    },
        { "name": "5 — 24px",   "slug": "5",  "size": "1.5rem"  },
        { "name": "6 — 32px",   "slug": "6",  "size": "2rem"    },
        { "name": "7 — 48px",   "slug": "7",  "size": "3rem"    },
        { "name": "8 — 64px",   "slug": "8",  "size": "4rem"    },
        { "name": "9 — 96px",   "slug": "9",  "size": "6rem"    },
        { "name": "10 — 128px", "slug": "10", "size": "8rem"    }
      ]
    },

    "layout": {
      "contentSize": "860px",
      "wideSize": "1200px"
    },

    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },

    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "name": "Small",  "slug": "sm", "shadow": "0 1px 3px rgba(38,52,75,0.08), 0 1px 2px rgba(38,52,75,0.04)" },
        { "name": "Medium", "slug": "md", "shadow": "0 4px 16px rgba(38,52,75,0.10), 0 2px 6px rgba(38,52,75,0.06)" },
        { "name": "Large",  "slug": "lg", "shadow": "0 12px 40px rgba(38,52,75,0.12), 0 4px 12px rgba(38,52,75,0.07)" }
      ]
    },

    "custom": {
      "spacing": {
        "outer": "clamp(1rem, 5vw, 3rem)"
      },
      "borderRadius": {
        "sm":   "0.375rem",
        "md":   "0.75rem",
        "lg":   "1.5rem",
        "xl":   "2.5rem",
        "blob": "60% 40% 55% 45% / 45% 55% 45% 55%",
        "full": "9999px"
      },
      "animation": {
        "durationFast":   "150ms",
        "durationBase":   "250ms",
        "durationSlow":   "400ms",
        "durationSlower": "600ms",
        "easingDefault":  "cubic-bezier(0.4, 0, 0.2, 1)",
        "easingOut":      "cubic-bezier(0, 0, 0.2, 1)",
        "easingSpring":   "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    }
  },

  "styles": {
    "color": {
      "background": "var(--wp--preset--color--neutral-050)",
      "text": "var(--wp--preset--color--neutral-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inclusive-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--6)",
      "padding": {
        "top": "0",
        "right": "var(--wp--custom--spacing--outer)",
        "bottom": "0",
        "left": "var(--wp--custom--spacing--outer)"
      }
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "lineHeight": "1.05",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--2xl)",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.3"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.4"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)",
          "lineHeight": "1.5"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary-700)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--primary-600)" },
          "typography": { "textDecoration": "none" }
        },
        ":focus-visible": {
          "color": { "text": "var(--wp--preset--color--primary-700)" }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary-600)",
          "text": "#ffffff"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1",
          "letterSpacing": "0.025em"
        },
        "border": {
          "radius": "var(--wp--custom--border-radius--full)",
          "width": "2px",
          "style": "solid",
          "color": "transparent"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--3)",
            "right": "var(--wp--preset--spacing--6)",
            "bottom": "var(--wp--preset--spacing--3)",
            "left": "var(--wp--preset--spacing--6)"
          }
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--primary-700)" }
        },
        ":focus-visible": {
          "color": { "background": "var(--wp--preset--color--primary-700)" }
        }
      }
    }
  }
}
